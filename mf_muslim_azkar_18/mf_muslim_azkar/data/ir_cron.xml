<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="azkar_cron" model="ir.cron">
            <field name="name">Azkar Reminder</field>
            <field eval="True" name="active"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="model_id" ref="mf_muslim_azkar.model_muslim_azkar"/>
            <field name="state">code</field>
            <field name="code">model.random_zikr_for_cron()</field>
        </record>

        <record id="azan_cron" model="ir.cron">
            <field name="name">Salah Reminder</field>
            <field eval="True" name="active"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="model_id" ref="mf_muslim_azkar.model_muslim_azan"/>
            <field name="state">code</field>
            <field name="code">model.cron_for_salah_reminder()</field>
        </record>

    </data>
</odoo>