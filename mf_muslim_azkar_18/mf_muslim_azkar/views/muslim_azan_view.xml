<odoo>
    <data>

        <record id="view_muslim_azan_form" model="ir.ui.view">
            <field name="name">muslim.azan.form</field>
            <field name="model">muslim.azan</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="zikr"/>
                            <field name="azan_time" widget="float_time"/>
                            <field name="all_users"/>
                            <field name="user_ids" readonly="all_users" widget="many2many_tags"/>
                        </group>
                        <footer>
                            <button name="cron_for_salah_reminder" type="object" string="Send" class="oe_highlight"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="view_muslim_azan_list" model="ir.ui.view">
            <field name="name">muslim.azan.list</field>
            <field name="model">muslim.azan</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="zikr"/>
                    <field name="azan_time" widget="float_time"/>
<!--                    <field name="all_users"/>-->
<!--                    <field name="user_ids" readonly="all_users"/>-->
                    <button name="cron_for_salah_reminder" type="object" string="Send"/>
                </list>
            </field>
        </record>

        <!-- Action -->
        <record id="action_muslim_azan" model="ir.actions.act_window">
            <field name="name">Muslim Azan</field>
            <field name="res_model">muslim.azan</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Menu Item -->
<!--        <menuitem id="parent_menu_muslim_azan" name="Muslim Azan" action="action_muslim_azan"-->
<!--                  groups="base.group_erp_manager"/>-->
        <menuitem id="menu_muslim_azan" name="Azan" action="action_muslim_azan" parent="parent_menu_muslim_azkar"/>

    </data>
</odoo>
